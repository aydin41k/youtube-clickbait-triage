{
  "manifest_version": 3,
  "name": "Local YouTube Packaging Triage",
  "version": "0.1.0",
  "description": "Automatic local Gemma packaging estimates for YouTube video cards.",
  "permissions": ["nativeMessaging", "storage"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"],
    "js": ["core.js", "frames.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
